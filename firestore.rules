rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper ----
    function isSiswa() {
      return request.auth != null
        && request.auth.token.email.matches('.*@siswa[.]sekolah[.]id$');
    }
    function isPemilikChat(nis) {
      return request.auth != null
        && request.auth.token.email == nis + '@siswa.sekolah.id';
    }
    function isStaff() {
      return request.auth != null
        && !isSiswa()
        && (exists(/databases/$(database)/documents/admin/$(request.auth.token.email))
            || exists(/databases/$(database)/documents/petugas/$(request.auth.token.email)));
    }

    match /kategori/{idKategori} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /siswa/{nis} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /admin/{emailAdmin} {
      allow read: if request.auth != null;
      // Dikelola manual lewat Firebase Console, KECUALI field fcm_token
      // (dipakai server untuk mengirim notifikasi push) yang boleh
      // diperbarui sendiri oleh admin yang bersangkutan saat login.
      allow update: if request.auth != null
        && request.auth.token.email == emailAdmin
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcm_token']);
      allow create, delete: if false;
    }
    match /petugas/{emailPetugas} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.token.email));
      // Petugas boleh memperbarui fcm_token miliknya sendiri (dipakai
      // server untuk mengirim notifikasi push), tanpa perlu hak akses
      // Admin.
      allow update: if request.auth != null
        && request.auth.token.email == emailPetugas
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcm_token']);
    }
    match /aspirasi/{idAspirasi} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if false;
      allow update: if request.auth != null
        && request.auth.token.email == resource.data.nis + '@siswa.sekolah.id'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rating', 'komentar_rating']);
      // Siswa perlu bisa menandai pengaduannya sendiri sebagai "sudah dibaca"
      // (dipanggil dari tandaiSemuaDibaca() saat pita notifikasi pembaruan
      // dipencet). Tanpa aturan ini, batch update itu ditolak Firestore
      // (permission-denied) dan badge notifikasi tidak akan pernah berkurang.
      allow update: if request.auth != null
        && request.auth.token.email == resource.data.nis + '@siswa.sekolah.id'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sudah_dibaca']);
      allow update: if request.auth != null
        && !request.auth.token.email.matches('.*@siswa[.]sekolah[.]id$')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'feedback', 'sudah_dibaca']);
      // Sama seperti rule di atas, tapi untuk saat Admin/Petugas JUGA
      // melampirkan/mengganti/menghapus foto bukti perbaikan dari halaman
      // Detail & Umpan Balik.
      allow update: if request.auth != null
        && !request.auth.token.email.matches('.*@siswa[.]sekolah[.]id$')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'feedback', 'sudah_dibaca', 'foto_bukti_petugas']);
      allow update: if request.auth != null
        && !request.auth.token.email.matches('.*@siswa[.]sekolah[.]id$')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'foto_bukti_petugas', 'sudah_dibaca', 'petugas_pengerja']);
      // Admin/Petugas meneruskan pengaduan ke Petugas (tombol "Teruskan ke
      // Petugas" di Dashboard Admin). Tanpa rule ini, update ditolak
      // permission-denied karena field 'diteruskan_petugas' tidak termasuk
      // di rule update manapun di atas.
      allow update: if request.auth != null
        && !request.auth.token.email.matches('.*@siswa[.]sekolah[.]id$')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['diteruskan_petugas']);
    }

    // ---- CHAT (Siswa <-> Admin/Petugas) ----
    // Sebelumnya TIDAK ADA blok untuk /chats sama sekali, sehingga
    // Firestore otomatis menolak semua akses (default deny) -> inilah
    // penyebab error "permission-denied" saat mengirim chat.
    match /chats/{nis} {
      allow read: if isPemilikChat(nis) || isStaff();
      allow write: if isPemilikChat(nis) || isStaff();

      match /pesan/{idPesan} {
        allow read: if isPemilikChat(nis) || isStaff();
        allow create: if isPemilikChat(nis) || isStaff();
        allow update, delete: if false;
      }
    }

    // ---- RATING APLIKASI (bukan rating per-pengaduan) ----
    // Dibaca SIAPA SAJA (termasuk yang belum login) karena ditampilkan di
    // halaman publik sebelum Login. Ditulis HANYA oleh siswa pemilik NIS
    // yang bersangkutan (id dokumen = NIS, dicocokkan dengan email
    // login-nya sendiri) supaya siswa tidak bisa mengatasnamakan siswa lain.
    match /rating_aplikasi/{nis} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == nis + '@siswa.sekolah.id';
      allow delete: if false;
    }

    match /log_aktivitas/{idLog} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
